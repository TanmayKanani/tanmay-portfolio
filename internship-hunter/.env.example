# ─────────────────────────────────────────────────────────────
#  Internship Hunter — configuration
#  Copy to .env  (`node bin/hunter.js init` does this for you)
#  .env is gitignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# ── Sending mail ──────────────────────────────────────────────
# Pick ONE of the two. The app password is far quicker and is the
# recommended route; OAuth is there if you would rather not store a
# password. If both are filled in, the app password is used.

# ── Option A: Gmail app password (about two minutes) ──────────
#   1. Turn on 2-Step Verification:  https://myaccount.google.com/security
#   2. Create an app password:       https://myaccount.google.com/apppasswords
#      (pick "Mail" / "Other", name it anything)
#   3. Paste the 16 characters below — spaces are fine, they're stripped
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=

# ── Option B: Gmail OAuth (about fifteen minutes) ─────────────
# At https://console.cloud.google.com create a project, then:
#   1. Enable the Gmail API
#   2. Create an OAuth 2.0 Client ID, type "Web application"
#   3. Add this exact redirect URI:  http://localhost:4300/auth/google/callback
#   4. On the OAuth consent screen add yourself as a Test user
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4300/auth/google/callback

# ── Claude (optional — without it, emails use the templates) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# ── Files ─────────────────────────────────────────────────────
# Relative paths resolve from the internship-hunter/ directory.
# Drop your PDF at assets/resume.pdf, or point this anywhere.
RESUME_PATH=./assets/resume.pdf
PROFILE_PATH=./config/profile.json

# ── Safety rails ──────────────────────────────────────────────
# Leave DRY_RUN=true until you have read your drafts (`hunter review`).
DRY_RUN=true
DAILY_SEND_CAP=25
PER_RUN_CAP=10
COMPANY_COOLDOWN_DAYS=30
MIN_DELAY_MS=45000
MAX_DELAY_MS=90000

# Only email addresses at or above this confidence.
#   0.6+  addresses the company published on its own site
#   0.4   inferred shared inboxes (careers@, jobs@) on a domain with live MX
# Most companies no longer publish an address — they use an application form —
# so 0.4 is the default, or the tool finds almost nobody to write to.
MIN_CONFIDENCE=0.4

# Infer shared hiring inboxes when a company publishes nothing. Only ever
# role mailboxes, never a guessed individual, and always MX-checked first.
# A wrong guess costs a bounce, which suppresses the address automatically.
ALLOW_PATTERN_GUESSES=true
REQUIRE_MX=true

# ── Follow-ups ────────────────────────────────────────────────
FOLLOWUP_ENABLED=true
FOLLOWUP_DAYS=7,14
MAX_FOLLOWUPS=2

# ── Discovery ─────────────────────────────────────────────────
DISCOVERY_SOURCES=remotive,remoteok,arbeitnow,himalayas
DISCOVERY_KEYWORDS=intern,internship,junior,entry level,graduate,new grad
DISCOVERY_LIMIT=50

# ── Scraping etiquette ────────────────────────────────────────
RESPECT_ROBOTS=true
SCRAPE_TIMEOUT_MS=12000
SCRAPE_HOST_DELAY_MS=2000

# ── Scheduler (off by default) ────────────────────────────────
SCHEDULER_ENABLED=false
DISCOVERY_CRON=0 9 * * 1-5
FOLLOWUP_CRON=0 10 * * 1-5
REPLY_SYNC_CRON=0 */3 * * *
# Let the scheduler send without you present. Think before enabling.
AUTO_SEND=false

# ── Server ────────────────────────────────────────────────────
PORT=4300
HOST=127.0.0.1
# Required if you expose the dashboard beyond localhost — the API can send mail.
DASHBOARD_TOKEN=
LOG_LEVEL=info
